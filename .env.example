# MongoDB
MONGODB_URI=mongodb://mongo:27017/questionmark

# Authentication
JWT_SECRET=replace_this_with_a_long_random_string

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Backend server
PORT=3000
NODE_ENV=production
CLIENT_URL=http://localhost:8080

# App constants
APP_NAME=QuestionMark
RANKS_PER_MARK_CONSTANT=500
CARELESS_MISTAKE_WINDOW_DAYS=14
CRON_SCHEDULE=30 15 * * *

# Frontend (for local dev outside Docker, if needed)
VITE_API_URL=http://localhost:3000/api
